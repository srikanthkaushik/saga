# Copy to .env next to docker-compose.yml and adjust. See deploy/unraid/README.md.

# ---- Where the stack is reached ---------------------------------------------------------------
# The Unraid server's address as your browser reaches it (LAN IP or a hostname every device resolves).
# Keycloak's public URL, the console's redirect URI and Kafka's external listener are built from it.
SAGA_HOST=192.168.1.50

# Host ports (change any that clash with other containers on the server)
CONSOLE_PORT=8080
ORDER_PORT=8081
PAYMENT_PORT=8082
INVENTORY_PORT=8083
AKHQ_PORT=8086
KEYCLOAK_PORT=8180
KAFKA_PORT=9092
POSTGRES_PORT=5432

# ---- Images ---------------------------------------------------------------------------------
SAGA_REGISTRY=ghcr.io/srikanthkaushik
SAGA_TAG=latest

# ---- Storage --------------------------------------------------------------------------------
# Postgres and Kafka data. Prefer the cache pool path (/mnt/cache/...) over /mnt/user/... for databases.
APPDATA=/mnt/cache/appdata/saga
TZ=Europe/London

# ---- Credentials (change all of these) -----------------------------------------------------------
# Postgres: applied only when the data folder is first initialised; changing it later has no effect
POSTGRES_USER=saga
POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
SAGA_CONSOLE_CLIENT_SECRET=change-me-console-secret
SAGA_PROMETHEUS_CLIENT_SECRET=change-me-prometheus-secret
# Passwords of the three saga users (viewer, operator, admin). Keycloak re-imports the realm on every start.
SAGA_VIEWER_PASSWORD=change-me-viewer
SAGA_OPERATOR_PASSWORD=change-me-operator
SAGA_ADMIN_PASSWORD=change-me-admin

# Kafka cluster id: formatted into the data folder on first start. Never change it while data exists.
KAFKA_CLUSTER_ID=_i2hTKrTS761Uu_cNefu5Q
